# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Appwrite Backend Configuration (server-side only for API key)
APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="MY_APPWRITE_PROJECT_ID"
APPWRITE_DATABASE_ID="MY_APPWRITE_DATABASE_ID"
APPWRITE_API_KEY="MY_APPWRITE_API_KEY"

# Appwrite Public Client Config (for Realtime & Auth)
VITE_APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="MY_APPWRITE_PROJECT_ID"
VITE_APPWRITE_DATABASE_ID="MY_APPWRITE_DATABASE_ID"
